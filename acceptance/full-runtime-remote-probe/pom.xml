<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.eclipse.kura</groupId><artifactId>kura-build-parent</artifactId><version>6.0.0-SNAPSHOT</version><relativePath /></parent>
  <artifactId>kura-full-runtime-triton-remote-acceptance</artifactId>
  <version>1.0.0-SNAPSHOT</version><packaging>bundle</packaging>
  <dependencies>
    <dependency><groupId>org.eclipse.kura</groupId><artifactId>org.eclipse.kura.api</artifactId><version>3.0.0-SNAPSHOT</version><scope>provided</scope></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.framework</artifactId><version>1.10.0</version><scope>provided</scope></dependency>
    <dependency><groupId>org.osgi</groupId><artifactId>org.osgi.service.component</artifactId><version>1.5.1</version><scope>provided</scope></dependency>
    <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.11.0</version><scope>provided</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.felix</groupId><artifactId>maven-bundle-plugin</artifactId><extensions>true</extensions>
      <configuration><instructions>
        <Bundle-SymbolicName>org.eclipse.kura.testing.fullruntime.tritonremote</Bundle-SymbolicName>
        <Bundle-Activator>org.eclipse.kura.triton.testing.fullruntime.RemoteProbe</Bundle-Activator>
        <Bundle-RequiredExecutionEnvironment>JavaSE-21</Bundle-RequiredExecutionEnvironment>
        <Private-Package>org.eclipse.kura.triton.testing.fullruntime</Private-Package><Export-Package>!*</Export-Package>
      </instructions></configuration>
    </plugin>
  </plugins></build>
</project>
